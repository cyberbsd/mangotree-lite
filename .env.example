# mangotree.tw account (email or phone) + password. Used only to log into www.mangotree.tw.
MT_EMAIL=
MT_PASSWORD=

# Show the browser window (true) or run hidden (false). Keep it visible the first time you log in.
MT_HEADLESS=false

# Local UI port
PORT=3456

# --- Reminders (pick any; leave blank to disable) ---
# ntfy.sh topic: install the ntfy app on your phone, subscribe to this topic name.
NTFY_TOPIC=
# Telegram bot token + chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: path to a Chrome/Chromium binary if Playwright's own download is not wanted
MT_CHROME_PATH=
